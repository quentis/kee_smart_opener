  {"name": "hcs300 v2: idle wait only, 2 cycles per tick", "source": "pull\n.wrap_target\nidle:\n    wait 1 pin 0\nhigh:\n    mov x, osr\nhi_loop:\n    jmp x-- hi_chk\n    jmp timeout\nhi_chk:\n    jmp pin hi_loop\n    in x, 32\n    push noblock\n    mov x, osr\nlo_loop:\n    jmp pin rising\n    jmp x-- lo_loop\ntimeout:\n    in x, 32\n    push noblock\n    wait 0 pin 0\n    jmp idle\nrising:\n    in x, 32\n    push noblock\n    jmp high\n.wrap\n", "code": [32928, 8352, 40999, 69, 11, 195, 16416, 32768, 40999, 207, 73, 16416, 32768, 8224, 1, 16416, 32768, 2], "wrap_target": 1, "wrap_top": 17, "origin": null, "side_set_count": 0, "side_set_opt": false, "side_set_pindirs": false, "public_defines": {}},
  {"name": "hcs300 v3: arm state, timeout built in the program", "source": "mov osr, ~null\nout null, 19\n.wrap_target\narm:\n    mov x, osr\narm_loop:\n    jmp pin arm\n    jmp x-- arm_loop\nidle:\n    wait 1 pin 0\nhigh:\n    mov x, osr\nhi_loop:\n    jmp x-- hi_chk\n    jmp stuck\nhi_chk:\n    jmp pin hi_loop\n    in x, 32\n    push noblock\n    mov x, osr\nlo_loop:\n    jmp pin rising\n    jmp x-- lo_loop\n    in x, 32\n    push noblock\n    jmp idle\nrising:\n    in x, 32\n    push noblock\n    jmp high\nstuck:\n    in x, 32\n    push noblock\n.wrap\n", "code": [41195, 24691, 40999, 194, 67, 8352, 40999, 73, 21, 199, 16416, 32768, 40999, 210, 77, 16416, 32768, 5, 16416, 32768, 6, 16416, 32768], "wrap_target": 2, "wrap_top": 22, "origin": null, "side_set_count": 0, "side_set_opt": false, "side_set_pindirs": false, "public_defines": {}},
