  {"name": "defines, expressions, origin, public labels", "source": ".define DELAY 3\n.define BITS 8\n.define public TE BITS * 2 + 3\n.define public SPAN (TE - 1) / 2\n.define public MIXED 7 - 2 - 1\n.define public NEGATIVE -4 + 9\n.define public REVERSED ::0x1\n.define public HEX 0x1F\n.define public BIN 0b101\n.origin 8\npublic entry:\n    set x, 1 [DELAY]\nloop:\n    out pins, BITS\n    set y, (BITS - 1) [DELAY - 1]\n    jmp x-- loop\n    jmp end - 1\n    jmp TE - 13\n    in x, (HEX + 1)\npublic end:\n    irq wait (HEX - 28)\n", "code": [58145, 24584, 57927, 65, 6, 6, 16416, 49187], "wrap_target": 0, "wrap_top": 7, "origin": 8, "side_set_count": 0, "side_set_opt": false, "side_set_pindirs": false, "public_defines": {"BIN": 5, "HEX": 31, "MIXED": 4, "NEGATIVE": 5, "REVERSED": -2147483648, "SPAN": 9, "TE": 19, "end": 7, "entry": 0}},
  {"name": "case insensitive keywords, case sensitive labels", "source": ".WRAP_TARGET\nStart:\n    SET X, 3\nLoop:\n    JMP X-- Loop [1]\n    jmp start_\nstart_:\n    Nop\n.WRAP\n", "code": [57379, 321, 3, 41026], "wrap_target": 0, "wrap_top": 3, "origin": null, "side_set_count": 0, "side_set_opt": false, "side_set_pindirs": false, "public_defines": {}},
  {"name": "lang_opt and c-sdk block, program in a file", "source": ".define public FILE_LEVEL 2\n.program blink\n.lang_opt python sideset_init = pico.PIO.OUT_LOW\n.side_set 1\n.wrap_target\n    set pins, 1 side 0 [FILE_LEVEL]\n    set pins, 0 side 1 [FILE_LEVEL]\n.wrap\n% c-sdk {\nstatic inline void blink_program_init(PIO pio) {\n    pio_gpio_init(pio, 0);\n}\n%}\n", "code": [57857, 61952], "wrap_target": 0, "wrap_top": 1, "origin": null, "side_set_count": 1, "side_set_opt": false, "side_set_pindirs": false, "public_defines": {"FILE_LEVEL": 2}},
  {"name": "hcs300 tx (without the directives pio-parser does not know)", "source": ".side_set 1 opt\n    set x, 1\n    in x, 6\n    in x, 1\n.wrap_target\nwait_start:\n    mov x, ~status\n    jmp !x wait_start\n    set x, 11 side 0\npreamble:\n    nop side 0 [1]\n    jmp x-- preamble side 1 [1]\n    set x, 17 side 0\nsync:\n    jmp x-- sync\n    mov x, ::isr\npwm:\n    out y, 1 side 1 [1]\n    mov pins, ~y [1]\n    jmp x-- pwm side 0 [1]\npwm_end:\n    out y, 30\n    set x, 8 [4]\nguard:\n    jmp x-- guard [7]\n.wrap\n", "code": [57377, 16422, 16417, 41005, 35, 61483, 45378, 6470, 61489, 73, 41014, 31041, 41226, 4427, 24670, 58408, 1872], "wrap_target": 3, "wrap_top": 16, "origin": null, "side_set_count": 1, "side_set_opt": true, "side_set_pindirs": false, "public_defines": {}},
