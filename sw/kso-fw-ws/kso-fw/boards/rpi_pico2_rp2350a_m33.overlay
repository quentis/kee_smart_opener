#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {

	cc1101_ldo: cc1101-ldo {
		compatible = "regulator-fixed";
		status = "okay";
		regulator-name = "cc1101-ldo";
		enable-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		startup-delay-us = <1000>;
	};

	rf_switch: rf-switch {
		compatible = "gpio-leds";
		status = "okay";

		rf_tx_en: tx-en {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		};
		rf_rx_en: rx-en {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		};
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		led_error: led-error {
			gpios = <&pico_header 12 GPIO_ACTIVE_LOW>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		status = "okay";

		pwm_led_blue: pwm-led-blue { pwms = <&pwm 9 PWM_USEC(1000) PWM_POLARITY_INVERTED>; }; /* GP9  - slice4B */
		pwm_led_green: pwm-led-green { pwms = <&pwm 10 PWM_USEC(1000) PWM_POLARITY_INVERTED>; }; /* GP10 - slice5A */
		pwm_led_red: pwm-led-red { pwms = <&pwm 11 PWM_USEC(1000) PWM_POLARITY_INVERTED>; }; /* GP11 - slice5B, shares freq w/ GP10 */
	};

	buttons: buttons {
		compatible = "gpio-keys";

		button_0: button-0 {
			gpios = <&pico_header 22 GPIO_ACTIVE_LOW>;
			label = "User Push Button 0";
			zephyr,code = <INPUT_BTN_0>;
		};

		button_1: button-1 {
			gpios = <&pico_header 26 GPIO_ACTIVE_LOW>;
			label = "User Push Button 1";
			zephyr,code = <INPUT_BTN_1>;
		};

		button_2: button-2 {
			gpios = <&pico_header 27 GPIO_ACTIVE_LOW>;
			label = "User Push Button 2";
			zephyr,code = <INPUT_BTN_2>;
		};

		button_3: button-3 {
			gpios = <&pico_header 28 GPIO_ACTIVE_LOW>;
			label = "User Push Button 3";
			zephyr,code = <INPUT_BTN_3>;
		};
	};

	longpress {
		compatible = "zephyr,input-longpress";
		input = <&buttons>;
		input-codes = <INPUT_BTN_0>, <INPUT_BTN_1>, <INPUT_BTN_2>, <INPUT_BTN_3>;
		short-codes = <INPUT_KEY_0>, <INPUT_KEY_1>, <INPUT_KEY_2>, <INPUT_KEY_3>;
		long-codes  = <INPUT_KEY_A>, <INPUT_KEY_B>, <INPUT_KEY_C>, <INPUT_KEY_D>;
		long-delay-ms = <1000>;
	};
};

&pinctrl {
	pwm_multi_default: pwm-multi-default {
		group1 {
			pinmux = <PWM_4B_P9>, <PWM_5A_P10>, <PWM_5B_P11>;
		};
	};

	pico2_spi0_default: pico2-spi0-default {
		group1 {
			// <SPI0_CSN_P17>
			pinmux = <SPI0_SCK_P18>, <SPI0_TX_P19>;
		};

		group2 {
			pinmux = <SPI0_RX_P16>;
			input-enable;
		};
	};
};

&pwm {
	status = "okay";
	pinctrl-0 = <&pwm_multi_default>;
	pinctrl-names = "default";
	divider-int-4 = <150>;
	divider-int-5 = <150>;
};

&adc {
	status = "disabled";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&pico2_spi0_default>;
	pinctrl-names = "default";
	/* CS is driven manually by the cc1101 driver via its own cs-gpios property */

	cc1101@0 {
		compatible = "ti,cc1101";
		status = "okay";
		reg = <0>;
		spi-max-frequency = <1000000>;
		int_gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>, <&gpio0 21 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

		frequency = <433920>;
		bitrate = <2500>;
	};
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

